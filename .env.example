# ==============================================================================
# DrivePro CRM & ERP - Hostinger Production Environment Configuration (.env)
# ==============================================================================

# Server Port (Hostinger Passenger dynamically assigns PORT if undefined)
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Hostinger MySQL Database Connection String (Prisma format)
# ------------------------------------------------------------------------------
# Format: mysql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:3306/<DB_NAME>
# Example for Hostinger cPanel / hPanel:
DATABASE_URL="mysql://u123456789_drivepro:StrongSecretPassword123!@127.0.0.1:3306/u123456789_srimuniskanna"

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET="generate_a_random_32_character_string_for_production_security"

# ------------------------------------------------------------------------------
# Base Website URL (Used for SEO, canonical links, and OpenGraph tags)
# ------------------------------------------------------------------------------
SITE_URL="https://nellaimuniskanna.com"

# ------------------------------------------------------------------------------
# WhatsApp Business API Cloud Integration (Optional)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN="YOUR_META_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_BUSINESS_ACCOUNT_ID"
WHATSAPP_VERIFY_TOKEN="CREATE_YOUR_OWN_RANDOM_VALUE"
WHATSAPP_API_VERSION="v20.0"
