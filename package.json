{
  "name": "drivepro-crm",
  "version": "1.0.0",
  "private": true,
  "description": "DrivePro CRM & ERP System with Sri Munis Kanna Driving School & Car Rentals Portal",
  "scripts": {
    "dev": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "prisma generate --schema=backend/prisma/schema.prisma || true",
    "build:all": "npm --prefix backend run prisma:generate && npm --prefix backend run build && npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:push": "npm --prefix backend run prisma:push",
    "start": "node server.js",
    "start:backend": "node backend/dist/index.js",
    "pack:hostinger": "node create_hostinger_zip.js",
    "zip": "npm run build:backend && npm run build:frontend && node create_hostinger_zip.js",
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma || true"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "keywords": [
    "driving-school-crm",
    "car-rentals",
    "drivepro",
    "erp"
  ],
  "author": "DrivePro / Sri Munis Kanna",
  "license": "ISC"
}
