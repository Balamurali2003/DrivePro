# DrivePro Driving School CRM & ERP - Environment Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Connection String (Prisma format)
# Local Development:
# DATABASE_URL="mysql://root:password@localhost:3306/srimuniskanna_crm"
#
# Hostinger / Production cPanel MySQL Format:
DATABASE_URL="mysql://u123456789_user:YourStrongPassword123!@127.0.0.1:3306/u123456789_srimuniskanna"

# Hostinger Specific Values Reference:
# DB_HOST="127.0.0.1" (or "localhost")
# DB_PORT=3306
# DB_NAME="u123456789_srimuniskanna"
# DB_USER="u123456789_user"
# DB_PASSWORD="YourStrongPassword123!"

# Authentication & JWT Security
JWT_SECRET="your_production_secure_jwt_secret_key_change_in_production"

# WhatsApp Business API Cloud Integration (Optional)
WHATSAPP_ACCESS_TOKEN="YOUR_META_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_BUSINESS_ACCOUNT_ID"
WHATSAPP_VERIFY_TOKEN="CREATE_YOUR_OWN_RANDOM_VALUE"
WHATSAPP_API_VERSION="v20.0"
