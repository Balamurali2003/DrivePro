model Referral {
  id                 String    @id @default(cuid())
  referrerStudentId  String?
  referrerStudent    Student?  @relation("ReferrerStudent", fields: [referrerStudentId], references: [id])
  referrerLeadId     String?
  referrerLead       Lead?     @relation("ReferrerLead", fields: [referrerLeadId], references: [id])
  referrerName       String
  referrerPhone      String
  referredName       String
  referredPhone      String
  referredEmail      String?
  referredLeadId     String?
  referredLead       Lead?     @relation("ReferredLead", fields: [referredLeadId], references: [id])
  referredStudentId  String?
  referredStudent    Student?  @relation("ReferredStudent", fields: [referredStudentId], references: [id])
