}

model UsedCarInventory {
  id                   String    @id @default(cuid())
  carCode              String    @unique
  registrationNumber   String    @unique
  make                 String
  model                String
  variant              String?
  year                 Int
  odometerKm           Int
  fuelType             String
  transmission         String
  color                String
  ownersCount          Int       @default(1)
  insuranceType        String    @default("COMPREHENSIVE")
  insuranceExpiry      DateTime?
  pucExpiry            DateTime?
  conditionScore       Int       @default(85)
  purchasePrice        Float
  expectedSalePrice    Float
  expectedSellingPrice Float?
  minimumPrice         Float
  status               String    @default("AVAILABLE")
  photos               String?
  primaryImage         String?
  features             String?
  notes                String?

  // Location & Seller info
  location         String? @default("Indiranagar, Bengaluru")
  registrationYear Int?
  sellerId         String?
  sellerName       String?
  sellerPhone      String?
  sellerEmail      String?
  sellerAddress    String?
