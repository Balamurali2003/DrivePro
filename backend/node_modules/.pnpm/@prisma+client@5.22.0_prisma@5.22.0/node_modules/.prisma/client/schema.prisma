model UsedCarExpense {
  id          String           @id @default(cuid())
  carId       String
  car         UsedCarInventory @relation(fields: [carId], references: [id], onDelete: Cascade)
  category    String
  amount      Float
  expenseDate DateTime         @default(now())
  vendor      String?
  description String
  receiptUrl  String?
  createdAt   DateTime         @default(now())
}

model UsedCarSale {
  id                String           @id @default(cuid())
  saleCode          String           @unique
  carId             String           @unique
  car               UsedCarInventory @relation(fields: [carId], references: [id], onDelete: Cascade)
  buyerName         String
  buyerPhone        String
  buyerEmail        String?
  buyerAddress      String?
  salePrice         Float
  discount          Float            @default(0)
  bookingAmount     Float            @default(0)
  paidAmount        Float
  pendingAmount     Float            @default(0)
  paymentMode       String           @default("BANK_TRANSFER")
  saleDate          DateTime         @default(now())
  deliveryDate      DateTime?
  salespersonId     String?
  salesperson       User?            @relation("SalesExecutive", fields: [salespersonId], references: [id])
  salespersonName   String
  rtoTransferStatus String           @default("IN_PROGRESS")

  purchaseCost    Float    @default(0)
  totalRepairs    Float    @default(0)
  totalExpenses   Float    @default(0)
  totalCost       Float    @default(0)
