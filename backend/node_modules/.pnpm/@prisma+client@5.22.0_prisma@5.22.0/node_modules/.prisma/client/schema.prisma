// ============================================================================
// WHATSAPP BUSINESS API & TWO-WAY COMMUNICATION HUB
// ============================================================================

model WhatsAppConversation {
  id                 String    @id @default(cuid())
  leadId             String?
  lead               Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  studentId          String?
  student            Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  customerId         String?
  phoneNumber        String // Normalized digits e.g. 919876543210
  contactName        String
  customerType       String    @default("LEAD") // "LEAD", "STUDENT", "CUSTOMER", "UNKNOWN"
  status             String    @default("OPEN") // "OPEN", "WAITING_FOR_REPLY", "RESOLVED"
  unreadCount        Int       @default(0)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages WhatsAppMessage[]
}

model WhatsAppMessage {
  id                String               @id @default(cuid())
  conversationId    String
  conversation      WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  whatsappMessageId String?              @unique // Meta WAMID
  direction         String // "INCOMING" | "OUTGOING"
  messageType       String               @default("text") // "text", "image", "document", "video", "audio", "template", "location", "interactive"
  messageText       String?
  mediaUrl          String?
  mediaType         String?
  templateName      String?
  status            String               @default("SENT") // "QUEUED", "SENDING", "SENT", "DELIVERED", "READ", "FAILED"
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  errorCode         String?
  errorMessage      String?
  senderName        String?
  createdAt         DateTime             @default(now())
}

model WhatsAppWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique // WhatsApp event ID / message ID for idempotency
  payload     String // Raw JSON payload
  eventType   String // "messages", "statuses", etc.
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
}

model WhatsAppBroadcast {
  id              String                       @id @default(cuid())
  name            String
  message         String?
  templateName    String?
  templateParams  String? // JSON string of parameter mappings
  totalRecipients Int                          @default(0)
  queued          Int                          @default(0)
  sent            Int                          @default(0)
  delivered       Int                          @default(0)
  read            Int                          @default(0)
  failed          Int                          @default(0)
  createdBy       String?
  createdAt       DateTime                     @default(now())
  recipients      WhatsAppBroadcastRecipient[]
}

model WhatsAppBroadcastRecipient {
  id                String            @id @default(cuid())
  broadcastId       String
  broadcast         WhatsAppBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  studentId         String?
  student           Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  recipientName     String?
  phoneNumber       String
  whatsappMessageId String?
  status            String            @default("QUEUED") // "QUEUED", "SENT", "DELIVERED", "READ", "FAILED"
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime          @default(now())
}
