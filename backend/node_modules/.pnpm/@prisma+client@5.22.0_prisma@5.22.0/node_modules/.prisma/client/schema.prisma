  source           String            @default("WEBSITE")
  salespersonName  String?
  status           String            @default("NEW")
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  testDrives UsedCarTestDrive[]
}

model UsedCarTestDrive {
  id              String           @id @default(cuid())
  testDriveCode   String           @unique
  carId           String
  car             UsedCarInventory @relation(fields: [carId], references: [id], onDelete: Cascade)
  buyerLeadId     String?
  buyerLead       UsedCarLead?     @relation(fields: [buyerLeadId], references: [id])
  buyerInquiryId  String?
  buyerInquiry    BuyerInquiry?    @relation(fields: [buyerInquiryId], references: [id])
  leadId          String?
  lead            Lead?            @relation(fields: [leadId], references: [id])
  studentId       String?
  student         Student?         @relation(fields: [studentId], references: [id])
  buyerName       String
  buyerPhone      String
