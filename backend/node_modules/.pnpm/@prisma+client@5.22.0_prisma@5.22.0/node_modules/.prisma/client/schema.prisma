  timeSlot        String
  startTime       String?
  endTime         String?
  salespersonId   String?
  salespersonName String
  status          String           @default("SCHEDULED") // REQUESTED, SCHEDULED, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
