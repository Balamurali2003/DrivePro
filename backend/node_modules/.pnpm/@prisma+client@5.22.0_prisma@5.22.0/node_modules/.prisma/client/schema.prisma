  fullName       String
  phone          String
  email          String
  roleTitle      String
  department     String
  joiningDate    DateTime @default(now())
  monthlySalary  Float    @default(25000)
  commissionRate Float    @default(0)
  status         String   @default("ACTIVE")
  idProofNumber  String?
  panNumber      String?
  bankAccount    String?
  bankIfsc       String?
  notes          String?
  createdAt      DateTime @default(now())
