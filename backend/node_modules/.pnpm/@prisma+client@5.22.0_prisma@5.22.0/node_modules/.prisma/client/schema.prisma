datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String   @default("STAFF")
  avatar       String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads      Lead[]         @relation("AssignedSales")
  managedFollowups   LeadFollowup[]
  instructorProfile  Instructor?
  studentProfile     Student?
  employeeProfile    Employee?
  auditLogs          AuditLog[]
  notifications      Notification[]
  complaintsAssigned Complaint[]    @relation("AssignedComplaint")
  createdExpenses    Expense[]
  usedCarSales       UsedCarSale[]  @relation("SalesExecutive")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id                        String    @id @default(cuid())
  leadCode                  String    @unique
  leadSequence              Int?
  fullName                  String
  phone                     String
  whatsappNumber            String?
  email                     String?
  gender                    String?
  age                       Int?
  address                   String?
  area                      String?
  preferredLanguage         String?
  licenceType               String?
  courseInterested          String?
  packageInterested         String?
  trainingRequirement       String    @default("Both Licence + Driving") // "Licence Only", "Driving Only", "Both Licence + Driving"
  classPreference           String    @default("Weekend Class") // "Weekend Class", "Weekdays Class"
  transmission              String    @default("MANUAL")
  preferredTiming           String?
  preferredInstructorGender String?
  preferredLocation         String?
  budget                    Float?
  expectedJoiningDate       DateTime?
  leadSource                String    @default("WEBSITE")
  campaign                  String?
  assignedToId              String?
  assignedTo                User?     @relation("AssignedSales", fields: [assignedToId], references: [id])
  priority                  String    @default("MEDIUM")
  status                    String    @default("NEW")
  aiScore                   Int       @default(50)
  aiRecommendation          String?
  lastCommunicationAt       DateTime?
  nextFollowUpAt            DateTime?
  expectedJoinDate          DateTime?
  notInterestedReason       String?
  notes                     String?

  // Real Meta & Sri Munis Kanna Enquiry Fields
  metaLeadId                String?
  adId                      String?
  adName                    String?
  adSetId                   String?
  adSetName                 String?
  campaignId                String?
  campaignName              String?
  leadCampaign              String?
  formId                    String?
  formName                  String?
  isOrganic                 Boolean? @default(false)
  platform                  String?
  location                  String?
  originalLocation          String?
  normalizedLocation        String?
  latitude                  Float?
  longitude                 Float?
  previousDrivingExperience String?
  preferredStartTime        String?
  contactPreference         String?
  dataSources               String? // "Meta", "Sri Munis Kanna Enquiry", "Meta + Sri Munis Kanna Enquiry"
  originalStatus            String?
  interestedVehicle         String?
  batch                     String?
  days                      String?

  // Automatic Priority Scoring
  priorityScore     Int      @default(10)
  priorityLevel     String   @default("LOW") // "HIGH", "MEDIUM", "LOW"
  priorityUpdatedAt DateTime @default(now())
  priorityReasons   String?

  // Current Location & Address details
  currentLocation String?
  city            String?
  district        String?
  state           String? @default("Tamil Nadu")
  pincode         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  communications              LeadCommunication[]
  followups                   LeadFollowup[]
  activities                  LeadActivity[]
  statusHistory               LeadStatusHistory[]
  locationHistory             LeadLocationHistory[]
  convertedStudent            Student?
  referralsMade               Referral[]                   @relation("ReferrerLead")
  referredIn                  Referral[]                   @relation("ReferredLead")
  campaignRef                 Campaign?                    @relation("CampaignLeads", fields: [campaignId], references: [id])
  testDrives                  UsedCarTestDrive[]
  whatsAppConversations       WhatsAppConversation[]
  whatsAppBroadcastRecipients WhatsAppBroadcastRecipient[]
}

model LeadLocationHistory {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldLocation  String?
  newLocation  String?
  oldLatitude  Float?
  oldLongitude Float?
  newLatitude  Float?
  newLongitude Float?
  changedBy    String   @default("Staff")
  changedAt    DateTime @default(now())
}

model LeadImportHistory {
  id                String   @id @default(cuid())
  fileName          String
  sheetName         String?
  importType        String?  @default("LEADS")
  totalRecords      Int
  successfulRecords Int
  failedRecords     Int
  duplicateRecords  Int
  updatedRecords    Int?     @default(0)
  importedBy        String   @default("Staff")
  importedAt        DateTime @default(now())
}

model LeadFollowup {
  id               String    @id @default(cuid())
  leadId           String
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  activityType     String
  followupDate     DateTime
  time             String?
  notes            String
  outcome          String?
  nextFollowupDate DateTime?
  reminderSent     Boolean   @default(false)
  status           String    @default("SCHEDULED")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actionType  String
  description String
  actorName   String
  metadata    String?
  createdAt   DateTime @default(now())
}

model LeadStatusHistory {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  changedBy  String
  reason     String?
  createdAt  DateTime @default(now())
}

model Student {
  id                    String    @id @default(cuid())
  studentCode           String    @unique
  userId                String?   @unique
  user                  User?     @relation(fields: [userId], references: [id])
  leadId                String?   @unique
  lead                  Lead?     @relation(fields: [leadId], references: [id])
  fullName              String
  photo                 String?
  phone                 String
  whatsappNumber        String?
  email                 String?
  gender                String
  dob                   DateTime?
  address               String?
  area                  String?
  emergencyContactName  String?
  emergencyContactPhone String?
  idProofType           String?
  idProofNumber         String?
  learnerLicenceNumber  String?
  learnerLicenceExpiry  DateTime?
  drivingLicenceNumber  String?
  drivingLicenceExpiry  DateTime?
  medicalCertificate    Boolean   @default(false)

  assignedInstructorId String?
  assignedInstructor   Instructor? @relation(fields: [assignedInstructorId], references: [id])
  assignedVehicleId    String?
  assignedVehicle      Vehicle?    @relation(fields: [assignedVehicleId], references: [id])

  status             String   @default("ACTIVE")
  progressPercentage Int      @default(0)
  totalLessons       Int      @default(15)
  completedLessons   Int      @default(0)
  remainingLessons   Int      @default(15)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  enrollments                 Enrollment[]
  lessons                     Lesson[]
  payments                    Payment[]
  invoices                    Invoice[]
  refunds                     Refund[]
  tests                       Test[]
  licenceRecords              LicenceRecord[]
  complaints                  Complaint[]
  feedbacks                   Feedback[]
  documents                   StudentDocument[]
  attendanceRecords           LessonAttendance[]
  skillProgress               LessonProgress[]
  referralsGiven              Referral[]                   @relation("ReferrerStudent")
  referredIn                  Referral[]                   @relation("ReferredStudent")
  testDrives                  UsedCarTestDrive[]
  renewals                    Renewal[]
  attendances                 Attendance[]
  whatsAppConversations       WhatsAppConversation[]
  whatsAppBroadcastRecipients WhatsAppBroadcastRecipient[]

  // Real Sri Munis Kanna Driving School fields
  batch               String?
  licenseStatus       String?
  vehicleType         String?
  joiningDate         DateTime?
  courseJoined        String?
  age                 Int?
  trainingRequirement String?
  classPreference     String?
  location            String?
  city                String?
  district            String?
  state               String?                   @default("Tamil Nadu")
  pincode             String?
  latitude            Float?
  longitude           Float?
  totalFees           Float?
  paidAmount          Float?
  balanceAmount       Float?
  paymentDate         String?
  paymentMode         String?
  receiptNumber       String?
  attendanceHistory   StudentAttendanceRecord[]
}

model StudentAttendanceRecord {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classDate  DateTime
  dateString String // "19/05/2026", "20/05/2026", etc.
  status     String // "Present", "Absent", "Leave"
  createdAt  DateTime @default(now())
}

model StudentDocument {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentType String
  documentName String
  fileUrl      String
  issueDate    DateTime?
  expiryDate   DateTime?
  status       String    @default("VERIFIED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Course {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  description           String?
  courseType            String   @default("STANDARD")
  transmission          String   @default("MANUAL")
  vehicleType           String   @default("LMV_4W")
  numberOfLessons       Int      @default(15)
  lessonDurationMinutes Int      @default(60)
  price                 Float
  discount              Float    @default(0)
  taxRate               Float    @default(18.0)
  totalFee              Float
  validityDays          Int      @default(90)
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  packages    CoursePackage[]
  enrollments Enrollment[]
}

model CoursePackage {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  bonusLessons  Int      @default(0)
  extraFeatures String?
  price         Float
  discount      Float    @default(0)
  totalFee      Float
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments Enrollment[]
}

model Enrollment {
  id               String         @id @default(cuid())
  enrollmentCode   String         @unique
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course         @relation(fields: [courseId], references: [id])
  packageId        String?
  package          CoursePackage? @relation(fields: [packageId], references: [id])
  enrollmentDate   DateTime       @default(now())
  startDate        DateTime?
  endDate          DateTime?
  totalFee         Float
  discount         Float          @default(0)
  taxAmount        Float          @default(0)
  finalFee         Float
  paidAmount       Float          @default(0)
  pendingAmount    Float          @default(0)
  totalLessons     Int
  completedLessons Int            @default(0)
  remainingLessons Int
  status           String         @default("ACTIVE")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  payments     Payment[]
  invoices     Invoice[]
  installments PaymentInstallment[]
}

model Instructor {
  id                  String   @id @default(cuid())
  instructorCode      String   @unique
  userId              String?  @unique
  user                User?    @relation(fields: [userId], references: [id])
  fullName            String
  photo               String?
  phone               String
  email               String?
  gender              String   @default("Male")
  address             String?
  area                String?
  joiningDate         DateTime @default(now())
  experienceYears     Int      @default(3)
  drivingLicence      String
  licenceExpiry       DateTime
  specializations     String
  languages           String
  workingHours        String   @default("07:00-19:00")
  baseSalary          Float    @default(25000)
  commissionPerLesson Float    @default(150)
  rating              Float    @default(4.8)
  totalReviews        Int      @default(0)
  status              String   @default("AVAILABLE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  assignedStudents Student[]
  lessons          Lesson[]
  assignedVehicles Vehicle[]
  availabilities   InstructorAvailability[]
  feedbacks        Feedback[]
  commissions      Commission[]
  attendances      Attendance[]
}

model InstructorAvailability {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startTime    String
  endTime      String
  isAvailable  Boolean    @default(true)
}

model Vehicle {
  id                   String      @id @default(cuid())
  vehicleCode          String      @unique
  registrationNumber   String      @unique
  make                 String
  model                String
  year                 Int
  fuelType             String
  transmission         String
  color                String
  purchaseDate         DateTime?
  purchaseCost         Float?
  currentKm            Int         @default(15000)
  fuelEfficiency       Float       @default(16.5)
  insuranceExpiry      DateTime
  pucExpiry            DateTime
  fitnessExpiry        DateTime
  lastServiceDate      DateTime?
  nextServiceDate      DateTime
  lastServiceKm        Int         @default(10000)
  nextServiceKm        Int         @default(20000)
  assignedInstructorId String?
  assignedInstructor   Instructor? @relation(fields: [assignedInstructorId], references: [id])
  status               String      @default("AVAILABLE")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  assignedStudents Student[]
  lessons          Lesson[]
  maintenanceLogs  VehicleMaintenance[]
  fuelLogs         VehicleFuelLog[]
  expenses         VehicleExpense[]
  documents        VehicleDocument[]
  attendances      Attendance[]
}

model VehicleDocument {
  id         String    @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  docType    String
  docNumber  String?
  fileUrl    String?
  issueDate  DateTime?
  expiryDate DateTime?
  status     String    @default("VALID")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model VehicleMaintenance {
  id              String    @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceType     String
  serviceDate     DateTime
  kmAtService     Int
  vendorName      String
  vendorContact   String?
  invoiceNumber   String?
  cost            Float
  nextServiceDate DateTime?
  nextServiceKm   Int?
  notes           String?
  status          String    @default("COMPLETED")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model VehicleFuelLog {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  logDate       DateTime
  fuelType      String
  litres        Float
  pricePerLitre Float
  totalCost     Float
  odometerKm    Int
  fuelStation   String?
  receiptUrl    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VehicleExpense {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category    String
  amount      Float
  expenseDate DateTime
  description String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
}

model Lesson {
  id                   String     @id @default(cuid())
  lessonCode           String     @unique
  studentId            String
  student              Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructorId         String
  instructor           Instructor @relation(fields: [instructorId], references: [id])
  vehicleId            String
  vehicle              Vehicle    @relation(fields: [vehicleId], references: [id])
  lessonDate           DateTime
  startTime            String
  endTime              String
  durationMinutes      Int        @default(60)
  pickupLocation       String?
  dropLocation         String?
  lessonType           String     @default("PRACTICAL")
  topicCovered         String?
  notes                String?
  status               String     @default("SCHEDULED")
  instructorCommission Float      @default(150)
  commissionPaid       Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  attendance  LessonAttendance?
  progress    LessonProgress?
  attendances Attendance[]
}

model Attendance {
  id             String      @id @default(cuid())
  attendanceCode String      @unique @default(cuid())
  studentId      String
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String?
  class          Lesson?     @relation(fields: [classId], references: [id])
  instructorId   String?
  instructor     Instructor? @relation(fields: [instructorId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?    @relation(fields: [vehicleId], references: [id])
  date           DateTime
  dateString     String? // "19052026", "2026-05-19"
  status         String      @default("Not Marked") // "Present", "Absent", "Leave", "Late", "Not Marked"
  checkInTime    String?
  checkOutTime   String?
  remarks        String?
  markedBy       String      @default("Front Desk Staff")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model LessonAttendance {
  id               String    @id @default(cuid())
  lessonId         String    @unique
  lesson           Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id])
  studentStatus    String    @default("PRESENT")
  instructorStatus String    @default("PRESENT")
  checkInTime      DateTime?
  checkOutTime     DateTime?
  startKm          Int?
  endKm            Int?
  distanceKm       Float?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model LessonProgress {
  id                String   @id @default(cuid())
  lessonId          String   @unique
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicsCovered     String
  overallScore      Int      @default(4)
  overallSkillLevel String   @default("PRACTICING")
  instructorNotes   String?
  mistakesObserved  String?
  recommendations   String?
  nextLessonFocus   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  skills LessonSkill[]
}

model LessonSkill {
  id          String         @id @default(cuid())
  progressId  String
  progress    LessonProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  skillName   String
  proficiency String         @default("LEARNING")
  score       Int            @default(3)
  notes       String?
}

model Payment {
  id            String      @id @default(cuid())
  paymentCode   String      @unique
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId  String?
  enrollment    Enrollment? @relation(fields: [enrollmentId], references: [id])
  invoiceId     String?
  invoice       Invoice?    @relation(fields: [invoiceId], references: [id])
  amount        Float
  paymentDate   DateTime    @default(now())
  dueDate       DateTime?
  paymentMode   String      @default("UPI")
  transactionId String?
  paymentStatus String      @default("PAID")
  receiptNumber String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  refunds Refund[]
}

model PaymentInstallment {
  id                String     @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  installmentNumber Int
  dueDate           DateTime
  amount            Float
  paidAmount        Float      @default(0)
  balanceAmount     Float
  status            String     @default("PENDING")
  reminderSent      Boolean    @default(false)
  paidDate          DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Invoice {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId  String?
  enrollment    Enrollment? @relation(fields: [enrollmentId], references: [id])
  type          String      @default("INVOICE")
  subtotal      Float
  discount      Float       @default(0)
  taxRate       Float       @default(18.0)
  taxAmount     Float       @default(0)
  totalAmount   Float
  paidAmount    Float       @default(0)
  balanceAmount Float       @default(0)
  invoiceDate   DateTime    @default(now())
  dueDate       DateTime?
  status        String      @default("PAID")
  items         String
  notes         String?
  terms         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  payments Payment[]
}

model Refund {
  id              String    @id @default(cuid())
  refundCode      String    @unique
  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentId       String?
  payment         Payment?  @relation(fields: [paymentId], references: [id])
  refundReason    String
  requestedAmount Float
  approvedAmount  Float     @default(0)
  refundedAmount  Float     @default(0)
  approvedBy      String?
  processedBy     String?
  requestedAt     DateTime  @default(now())
  approvedAt      DateTime?
  processedAt     DateTime?
  refundDate      DateTime  @default(now())
  refundMethod    String    @default("UPI")
  status          String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, PROCESSING, COMPLETED, CANCELLED
  transactionRef  String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Complaint {
  id               String    @id @default(cuid())
  ticketCode       String    @unique
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category         String
  priority         String    @default("MEDIUM")
  title            String
  description      String
  assignedToId     String?
  assignedTo       User?     @relation("AssignedComplaint", fields: [assignedToId], references: [id])
  dueDate          DateTime?
  status           String    @default("OPEN")
  resolution       String?
  resolvedAt       DateTime?
  customerRating   Int?
  customerFeedback String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  comments ComplaintComment[]
}

model ComplaintComment {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorName  String
  authorRole  String
  comment     String
  isInternal  Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Feedback {
  id               String      @id @default(cuid())
  studentId        String
  student          Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructorId     String?
  instructor       Instructor? @relation(fields: [instructorId], references: [id])
  instructorRating Int         @default(5)
  vehicleRating    Int         @default(5)
  lessonRating     Int         @default(5)
  schedulingRating Int         @default(5)
  overallRating    Int         @default(5)
  reviewText       String?
  isPublic         Boolean     @default(true)
  createdAt        DateTime    @default(now())
}

model Test {
  id            String    @id @default(cuid())
  testCode      String    @unique
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testType      String
  testDate      DateTime
  timeSlot      String?
  location      String
  instructorId  String?
  vehicleId     String?
  result        String    @default("PENDING")
  score         Int?
  failureReason String?
  nextTestDate  DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LicenceRecord {
  id                  String    @id @default(cuid())
  studentId           String?
  student             Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName         String?
  licenceType         String    @default("LMV")
  applicationNumber   String?   @default("APP-RTO")
  applicationDate     DateTime  @default(now())
  llDate              DateTime?
  testDate            DateTime?
  drivingTestDate     DateTime?
  result              String    @default("IN_PROCESS")
  licenceNumber       String?
